# jot — Environment Variables
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# PDF Search (Brave Search API — free tier: 2,000 queries/month)
# https://brave.com/search/api/
BRAVE_API_KEY=

# YouTube Transcription (AssemblyAI — ~$0.006/min)
# https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Paragraph Breaks (Anthropic Claude)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
