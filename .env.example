# Copy to ~/.config/jot/.env or a local .env, then fill in only the keys you need.
# Evaluation is opt-in; caption-based transcription needs no API key.

# OpenRouter watch-value evaluation (--evaluate)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional AssemblyAI audio fallback and speaker diarization
# Requires ffmpeg on PATH. https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=
