{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent watch-value evaluation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "verdict", "takeaways", "novelty", "signal", "worth_watching", "skippable", "limits"],
  "properties": {
    "request_id": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "audience", "reason", "confidence"],
      "properties": {
        "decision": {"enum": ["WATCH", "SKIM", "SKIP"]},
        "audience": {"$ref": "#/$defs/Text"},
        "reason": {"$ref": "#/$defs/Text"},
        "confidence": {"enum": ["low", "moderate", "high"]}
      }
    },
    "takeaways": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idea", "why", "evidence"],
        "properties": {
          "idea": {"$ref": "#/$defs/Text"},
          "why": {"$ref": "#/$defs/Text"},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Citation"}}
        }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "personal", "reason"],
      "properties": {
        "assessment": {"$ref": "#/$defs/Text"},
        "personal": {"enum": ["unknown", "low", "moderate", "high"]},
        "reason": {"$ref": "#/$defs/Text"}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["substance", "stories", "analogies", "repetition", "marketing", "housekeeping"],
      "properties": {
        "substance": {"$ref": "#/$defs/Signal"},
        "stories": {"$ref": "#/$defs/Signal"},
        "analogies": {"$ref": "#/$defs/Signal"},
        "repetition": {"$ref": "#/$defs/Signal"},
        "marketing": {"$ref": "#/$defs/Signal"},
        "housekeeping": {"$ref": "#/$defs/Signal"}
      }
    },
    "worth_watching": {"type": "array", "items": {"$ref": "#/$defs/Range"}},
    "skippable": {"type": "array", "items": {"$ref": "#/$defs/Range"}},
    "limits": {"type": "array", "items": {"$ref": "#/$defs/Text"}}
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {"pattern": "[\\r\\n]"}
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "quote"],
      "properties": {
        "timestamp": {"type": ["integer", "null"], "minimum": 0},
        "quote": {"$ref": "#/$defs/Text"}
      }
    },
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "reason", "evidence"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "reason": {"$ref": "#/$defs/Text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Citation"}}
      }
    },
    "Signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "reason", "evidence"],
      "properties": {
        "rating": {"enum": ["low", "moderate", "high", "not_observed"]},
        "reason": {"$ref": "#/$defs/Text"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/Citation"}}
      },
      "if": {"properties": {"rating": {"enum": ["low", "moderate", "high"]}}, "required": ["rating"]},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    }
  }
}
